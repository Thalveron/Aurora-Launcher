<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#182737"/><corners android:radius="12dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#9AF5FF"/><stroke android:width="3dp" android:color="#FFFFFF"/><corners android:radius="12dp"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#70D8EF"/><stroke android:width="3dp" android:color="#FFFFFF"/><corners android:radius="12dp"/></shape></item>
    <item><shape><solid android:color="#24364A"/><stroke android:width="1dp" android:color="#65839A"/><corners android:radius="12dp"/></shape></item>
</selector>
