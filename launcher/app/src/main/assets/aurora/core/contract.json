  "aliases": {
    "appearance": "config/appearance",
    "appearance/*": "config/appearance/*",
    "custom-css": "themes/custom-css",
    "library": "assets",
    "library/*": "assets/*",
    "apps/icon/*": "icons/*"
  },
  "routes": [
    {
      "method": "GET",
      "path": "time",
      "description": "时间/日期/农历/节日/时区"
    },
    {
      "method": "GET",
      "path": "weather",
      "description": "统一天气和缓存状态"
    },
    {
      "method": "GET",
      "path": "media",
      "description": "MediaSession信息"
    },
    {
      "method": "POST",
      "path": "media/{play|pause|next|prev|seek|mode}",
      "description": "seek:{positionMs}；mode:{mode:0单曲/1顺序/2随机}"
    },
    {
      "method": "GET",
      "path": "media/queue",
      "description": "当前队列"
    },
    {
      "method": "GET",
      "path": "media/cover",
      "description": "JPEG二进制"
    },
    {
      "method": "GET",
      "path": "apps",
      "description": "package/name/icon数组"
    },
    {
      "method": "POST",
      "path": "apps/launch",
      "description": "{package}，专用启动兼容入口"
    },
    {
      "method": "GET",
      "path": "status",
      "description": "存储/内存/网络/蓝牙"
    },
    {
      "method": "GET/POST",
      "path": "config",
      "description": "写字段：theme/locale/icon_fallback/system_backends"
    },
    {
      "method": "GET",
      "path": "themes",
      "description": "主题及available"
    },
    {
      "method": "POST",
      "path": "themes/switch",
      "description": "{theme}，校验已安装清单"
    },
    {
      "method": "GET",
      "path": "backgrounds",
      "description": "只返回背景素材数组"
    },
    {
      "method": "POST",
      "path": "backgrounds/upload",
      "description": "原始图片/视频流；Content-Length、X-File-Name"
    },
    {
      "method": "POST",
      "path": "backgrounds/delete",
      "description": "{id,confirm:true}，保护正在用的素材"
    },
    {
      "method": "GET/POST",
      "path": "config/appearance",
      "description": "外观；POST局部更新"
    },
    {
      "method": "POST",
      "path": "config/appearance/preview",
      "description": "外观内存预览，30秒过期"
    },
    {
      "method": "GET/POST",
      "path": "config/appearance/presets",
      "description": "{presets:[{name,values}]}，最多20项"
    },
    {
      "method": "GET/POST",
      "path": "themes/custom-css",
      "description": "{css}，校验后保存"
    },
    {
      "method": "GET",
      "path": "assets",
      "description": "全部素材数组"
    },
    {
      "method": "POST",
      "path": "assets/upload",
      "description": "原始流，按类型限制大小并校验"
    },
    {
      "method": "POST",
      "path": "assets/delete",
      "description": "{id,confirm:true}"
    },
    {
      "method": "GET",
      "path": "assets/file/{id}",
      "description": "二进制，支持Range206"
    },
    {
      "method": "GET",
      "path": "icons/{package}",
      "description": "真实应用图标PNG"
    },
    {
      "method": "POST",
      "path": "apps/install",
      "description": "{id}，后台安装上传的APK"
    },
    {
      "method": "GET",
      "path": "apps/jobs",
      "description": "安装任务数组"
    },
    {
      "method": "GET",
      "path": "actions",
      "description": "动作注册表；需登录"
    },
    {
      "method": "POST",
      "path": "actions",
      "description": "{action,params}"
    },
    {
      "method": "GET",
      "path": "bootstrap",
      "description": "初始化快照"
    },
    {
      "method": "WS",
      "path": "events",
      "description": "snapshot及增量事件"
    },
    {
      "method": "GET",
      "path": "system/capabilities",
      "description": "后端及可用状态"
    },
    {
      "method": "POST",
      "path": "system/connect",
      "description": "一次ADB授权请求"
    },
    {
      "method": "POST",
      "path": "system/key",
      "description": "{key:up/down/left/right/ok/back/home}"
    },
    {
      "method": "POST",
      "path": "system/standby/confirm",
      "description": "一次性60秒令牌"
    },
    {
      "method": "POST",
      "path": "system/standby",
      "description": "{confirmationToken}，二次确认"
    },
    {
      "method": "GET",
      "path": "system/screenshot",
      "description": "JPEG单帧，需登录"
    },
    {
      "method": "GET",
      "path": "system/screen.mjpeg",
      "description": "fps查询0.2～2；最多两名观看者"
    },
    {
      "method": "POST",
      "path": "system/{wifi|bluetooth|display}",
      "description": "打开系统设置"
    },
    {
      "method": "POST",
      "path": "themes/open",
      "description": "打开主题容器"
    },
    {
      "method": "GET",
      "path": "spectrum",
      "description": "真实bins数组，静音返回零"
    },
    {
      "method": "GET",
      "path": "saver",
      "description": "{active}"
    },
    {
      "method": "POST",
      "path": "saver/{enter|exit}",
      "description": "进入/退出屏保"
    },
    {
      "method": "GET",
      "path": "inputs",
      "description": "输入状态；unknown不等于断开"
    },
    {
      "method": "POST",
      "path": "inputs/switch",
      "description": "{id}，已枚举或TCL白名单"
    },
    {
      "method": "GET/POST",
      "path": "music/local/settings",
      "description": "coverEnabled/lyricsEnabled/lyricsUrls，Chora签名桥"
    },
    {
      "method": "POST",
      "path": "music/local/scan",
      "description": "后台扫描"
    },
    {
      "method": "GET",
      "path": "bgm",
      "description": "独立背景音乐状态"
    },
    {
      "method": "GET",
      "path": "bgm/library",
      "description": "音频数组"
    },
    {
      "method": "POST",
      "path": "bgm/upload",
      "description": "原始音频流；Content-Length、X-File-Name"
    },
    {
      "method": "POST",
      "path": "bgm/{play|pause|stop|volume|settings|delete}",
      "description": "现有BGM保留；volume:{volume:0～100}"
    },
    {
