{
  "apiVersion": 1,
  "policy": "Additive fields only; breaking changes require /api/v2/",
  "actions": [
    {
      "action": "launch_app",
      "parameters": {
        "package": "string"
      },
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "set_appearance",
      "parameters": {
        "patch": "object"
      },
      "permission": "settings",
      "requiresConfirmation": false
    },
    {
      "action": "open_settings",
      "parameters": {
        "kind": "string"
      },
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "switch_theme",
      "parameters": {
        "theme": "string"
      },
      "permission": "settings",
      "requiresConfirmation": false
    },
    {
      "action": "media_play",
      "parameters": {},
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "media_pause",
      "parameters": {},
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "media_next",
      "parameters": {},
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "media_prev",
      "parameters": {},
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "media_seek",
      "parameters": {
        "positionMs": "integer"
      },
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "media_mode",
      "parameters": {
        "mode": "integer"
      },
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "enter_saver",
      "parameters": {},
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "enter_saver_auto",
      "parameters": {},
      "permission": "control",
      "requiresConfirmation": false
    },
    {
      "action": "exit_saver",
      "parameters": {},
      "permission": "control",
      "requiresConfirmation": false
    }
  ],
  "schemas": {
    "time": {
      "type": "object",
      "required": [
        "epochMs",
        "time",
        "date",
        "weekday",
        "lunar",
        "festival",
        "timezone"
      ],
      "properties": {
        "epochMs": {
          "type": "integer"
        },
        "time": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "weekday": {
          "type": "string"
        },
        "lunar": {
          "type": "string"
        },
        "festival": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "weather": {
      "type": "object",
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "city": {
          "type": "string"
        }
      }
    },
    "media": {
      "type": "object",
      "required": [
        "available",
        "playing",
        "title",
        "artist",
        "positionMs",
        "durationMs",
        "lyrics",
        "lyricIndex",
        "lyricProgress"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "playing": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "positionMs": {
          "type": "number"
        },
        "durationMs": {
          "type": "number"
        },
        "lyrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lyricIndex": {
          "type": "integer"
        },
        "lyricProgress": {
          "type": "number"
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package",
          "name",
          "icon"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "storage",
        "memory",
        "network",
        "bluetooth"
      ],
      "properties": {
        "storage": {
          "type": "object",
          "required": [
            "total",
            "free"
          ],
          "properties": {
            "total": {
              "type": "number"
            },
            "free": {
              "type": "number"
            }
          }
        },
        "memory": {
          "type": "object",
          "required": [
            "total",
            "available"
          ],
          "properties": {
            "total": {
              "type": "number"
            },
            "available": {
              "type": "number"
            }
          }
        },
        "network": {
          "type": "object",
          "required": [
            "connected",
            "wifi",
            "ethernet"
          ],
          "properties": {
            "connected": {
              "type": "boolean"
            },
            "wifi": {
              "type": "boolean"
            },
            "ethernet": {
              "type": "boolean"
            }
          }
        },
        "bluetooth": {
          "type": "object",
          "required": [
            "known"
          ],
          "properties": {
            "known": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "theme",
        "locale",
        "icon_fallback"
      ],
      "properties": {
        "theme": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "icon_fallback": {
          "type": "string"
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      }
    },
    "backgrounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "url",
          "bytes",
          "video"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          },
          "video": {
            "type": "boolean"
          }
        }
      }
    },
    "config/appearance": {
      "type": "object",
      "required": [
        "fontZh",
        "fontEn",
        "fontSize",
        "text",
        "accent",
        "card",
        "lyricPast",
        "lyricActive",
        "lyricFuture",
        "focusStyle",
        "focusMotion",
        "focusColor",
        "focusWidth",
        "focusRadius",
        "focusGlow",
        "motionMs",
        "ambientMode",
        "ambientColor",
        "ambientOpacity",
        "desktopSpectrum",
        "saverSpectrum",
        "desktopSlides",
        "saverSlides",
        "slideSeconds",
        "saverSlideSeconds",
        "saverEnabled",
        "saverMinutes",
        "saverInfo",
        "saverMode",
        "layout",
        "greeting",
        "greetingStyle",
        "greetingSize",
        "greetingX",
        "greetingY",
        "saverLyricsLayout",
        "cardOpacity",
        "glassBlur",
        "backgroundDim",
        "cardRadius",
        "iconSize",
        "spacing",
        "fontScale"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "url",
          "bytes",
          "video"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "bytes": {
            "type": "number"
          },
          "video": {
            "type": "boolean"
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "required": [
        "config",
        "engines",
        "voices",
        "ready",
        "reason"
      ],
      "properties": {
        "config": {
          "type": "object",
          "required": [
            "enabled",
            "language",
            "engine",
            "voice",
            "rate",
            "pitch",
            "volume",
            "readFocus"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "language": {
              "type": "string"
            },
            "engine": {
              "type": "string"
            },
            "voice": {
              "type": "string"
            },
            "rate": {
              "type": "number"
            },
            "pitch": {
              "type": "number"
            },
            "volume": {
              "type": "number"
            },
            "readFocus": {
              "type": "boolean"
            }
          }
        },
        "engines": {
          "type": "array"
        },
        "voices": {
          "type": "array"
        },
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "parameters",
          "permission",
          "requiresConfirmation"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "permission": {
            "type": "string"
          },
          "requiresConfirmation": {
            "type": "boolean"
          }
        }
      }
