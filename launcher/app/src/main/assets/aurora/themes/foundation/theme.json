{
  "id": "foundation",
  "name": "极光接口验收预览",
  "version": "0.1.0",
  "apiVersion": 1,
  "components": [
    "clock",
    "weather",
    "media",
    "apps"
  ],
  "variables": {
    "--accent": "#77e8ef",
    "--card-radius": "24px",
    "--grid-cols": "6"
  },
  "icons": {
    "shape": "rounded",
    "size": 128
  },
  "finalDesign": false,
  "controls": [
    {
      "key": "cardOpacity",
      "label": "卡片透明度",
      "min": 0.05,
      "max": 0.6,
      "step": 0.01,
      "default": 0.24,
      "unit": ""
    },
    {
      "key": "glassBlur",
      "label": "毛玻璃模糊",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "key": "backgroundDim",
      "label": "背景压暗",
      "min": 0,
      "max": 0.8,
      "step": 0.01,
      "default": 0.2,
      "unit": ""
    },
    {
      "key": "cardRadius",
      "label": "卡片圆角",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "key": "iconSize",
      "label": "图标大小",
      "min": 24,
      "max": 160,
      "step": 1,
      "default": 64,
      "unit": "px"
    },
    {
      "key": "spacing",
      "label": "区块间距",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 26,
      "unit": "px"
    },
    {
      "key": "fontScale",
      "label": "字号缩放",
      "min": 0.6,
      "max": 1.8,
      "step": 0.05,
      "default": 1,
      "unit": "倍"
    }
  ]
}