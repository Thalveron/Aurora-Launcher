<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.alibaba.dingtalk.focus" android:versionCode="8" android:versionName="1.7">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <application android:label="Aurora Launcher 主页入口" android:allowBackup="false" android:directBootAware="true" android:theme="@android:style/Theme.Material.NoActionBar">
        <receiver android:name="org.cleanyourtv.homebridge.PreviewReceiver" android:exported="true" android:permission="com.gathin.tvhome.permission.DESKTOP_LYRICS" />
        <activity android:name="org.cleanyourtv.homebridge.HomeActivity" android:directBootAware="true" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="org.cleanyourtv.homebridge.PinShortcutActivity" android:exported="true" android:excludeFromRecents="true"><intent-filter><action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT"/><category android:name="android.intent.category.DEFAULT"/></intent-filter></activity>
        <activity android:name="org.cleanyourtv.homebridge.ShortcutLaunchActivity" android:exported="true" android:excludeFromRecents="true"/>
        <provider android:name="org.cleanyourtv.homebridge.ShortcutProvider" android:authorities="com.alibaba.dingtalk.focus.shortcuts" android:exported="true"/>
    </application>
</manifest>
